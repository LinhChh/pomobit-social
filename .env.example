# Copy this file to .env for local development. Never commit the real .env.
# In GitHub Actions these are provided as repository Secrets instead (see README.md).

FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Only needed to run src/generateContent.js (AI-generated post drafts).
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-5 if unset. Overridden per-run by --model.
ANTHROPIC_MODEL=
